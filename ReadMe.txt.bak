base settings in platformio.ini
		
[genericSTM32F446RE]
platform = ststm32
board = genericSTM32F446RE
framework = cmsis
upload_protocol = stlink
debug_tool = stlink

;**********************************************************************************************

[CodeChecking]
check_tool = cppcheck
check_flags =
  cppcheck: --enable=performance  --inline-suppr  --skip-packages

[env:debug]
extends = genericSTM32F446RE
build_unflags = -Os
build_flags = -O0 -g3 -ggdb
extra_scripts =     pre:test.py

[env:release]
extends = genericSTM32F446RE
build_unflags = -Os
build_flags = -O3 -g3 -ggdb
extra_scripts =     pre:test.py